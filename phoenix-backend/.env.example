# MongoDB connection string (include a database name, e.g. /phoenix)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/phoenix
# Random string, 32+ characters
JWT_SECRET=change-me-to-a-random-string-of-32-characters-or-more
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
PORT=8000
